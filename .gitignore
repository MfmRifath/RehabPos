# --- Data, models, experiment tracking (never commit) ---
# Anchored to the repo root: an unanchored `data/` also matched src/rehabpose/data/.
/data/
/mlruns/
/mlartifacts/
*.mp4
*.mov
*.avi
*.mkv
*.parquet
*.pt
*.pth
*.onnx
*.task
*.mlpackage/
*.mlmodel
*.db
*.sqlite

# Tiny synthetic fixtures (< 1 MB each) are allowed
!tests/fixtures/**

# Generated reports (keep folder; committed samples are added explicitly)
/reports/*
!/reports/.gitkeep
!/reports/samples/
!/reports/benchmarks.md
!/reports/benchmarks.json

# --- Python ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/public/mediapipe/
frontend/public/models/
frontend/test-results/
frontend/playwright-report/

# --- Env, OS, editors ---
.env
.env.*
!.env.example
.DS_Store
.idea/
.vscode/
.claude/settings.local.json
